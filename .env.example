# Sunless backend — environment variables
# Copy to .env on the server (backend loads these from the shell / .env in the run script)

# Port the backend listens on (nginx proxies /api/ here)
PORT=1000

# PostgreSQL connection (VDS)
DATABASE_URL=postgres://postgres:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME

# Comma-separated admin usernames (in addition to role=ADMIN users)
ADMIN_USERS=coderdlc

# Public site URL (used in reset-password emails)
SITE_URL=https://domain.com

# Optional SMTP for password reset emails (if empty, link is printed to console)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=