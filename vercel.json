{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "builds": [
    { "src": "**/*.html", "use": "@vercel/static" },
    { "src": "fonts/**", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/" },
    { "source": "/auth/(.*)", "destination": "/api/" },
    { "source": "/user/(.*)", "destination": "/api/" },
    { "source": "/settings/(.*)", "destination": "/api/" },
    { "source": "/payment/(.*)", "destination": "/api/" },
    { "source": "/media/(.*)", "destination": "/api/" },
    { "source": "/zaliv/(.*)", "destination": "/api/" },
    { "source": "/admin/(.*)", "destination": "/api/" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}